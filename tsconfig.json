{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "app/",
    "paths": {
      "@public/*": ["../public/*"],
      "@styles/*": ["_styles/*"],
      "@ui/elements/button": ["_ui/_elements/button/button.tsx"],
      "@ui/elements/backdrop": ["_ui/_elements/backdrop/backdrop.tsx"],
      "@ui/elements/inputField": ["_ui/_elements/inputField/inputField.tsx"],
      "@ui/elements/selectBox": ["_ui/_elements/selectBox/selectBox.tsx"],
      "@ui/elements/arrow": ["_ui/_elements/arrow/arrow.tsx"],
      "@ui/elements/tag": ["_ui/_elements/tag/tag.tsx"],
      "@ui/components/footer": ["_ui/_components/footer/footer.tsx"],
      "@ui/components/navbar": ["_ui/_components/navbar/navbar.tsx"],
      "@ui/components/navbarWrapper": ["_ui/_components/navbar/navbarWrapper.tsx"],
      "@ui/components/shapedImage": ["_ui/_components/shapedImage/shapedImage.tsx"],
      "@ui/components/card": ["_ui/_components/card/card.tsx"],
      "@ui/components/imageCard": ["_ui/_components/imageCard/imageCard.tsx"],
      "@ui/components/rubriqueProjetsAccordion": ["_ui/_components/rubriqueProjetsAccordion/rubriqueProjetsAccordion.tsx"],
      "@ui/components/articleList": ["_ui/_components/articleList/articleList.tsx"],
      "@graphql/*": ["_graphql/*"],
      "@services/remoteHtml": ["_services/_remoteHtml/remoteHtml.tsx"],
      "@services/apollo/*": ["_services/_apollo/*"],
      "@utils/dateUtils": ["_utils/dateUtils.tsx"],
      "@hooks/*": ["_hooks/*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
