{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": "app/",
    "paths": {
      "@public/*": ["../public/*"],
      "@globals/*": ["_globals/*"],
      "@data/queries": ["_data/queries.tsx"],
      "@ui/components/button": ["_ui/_components/button/button.tsx"],
      "@ui/components/linkButton": ["_ui/_components/button/linkButton.tsx"],
      "@ui/components/toTopButton": ["_ui/_components/button/toTopButton.tsx"],
      "@ui/components/backdrop": ["_ui/_components/backdrop/backdrop.tsx"],
      "@ui/components/inputField": ["_ui/_components/inputField/inputField.tsx"],
      "@ui/components/arrow": ["_ui/_components/arrow/arrow.tsx"],
      "@ui/components/tag": ["_ui/_components/tag/tag.tsx"],
      "@ui/components/loader": ["_ui/_components/loader/loader.tsx"],
      "@ui/components/pagination": ["_ui/_components/pagination/pagination.tsx"],
      "@ui/components/selectBox": ["_ui/_components/selectBox/selectBox.tsx"],
      "@ui/components/toggleGroup": ["_ui/_components/toggleGroup/toggleGroup.tsx"],
      "@ui/components/filterPopover": ["_ui/_components/filterPopover/filterPopover.tsx"],
      "@ui/components/shapedImage": ["_ui/_components/shapedImage/shapedImage.tsx"],
      "@ui/components/articleCard": ["_ui/_components/articleCard/articleCard.tsx"],
      "@ui/components/imageCard": ["_ui/_components/imageCard/imageCard.tsx"],
      "@ui/components/projectList": ["_ui/_components/projectList/projectList.tsx"],
      "@ui/components/articleList": ["_ui/_components/articleList/articleList.tsx"],
      "@ui/components/timeline": ["_ui/_components/timeline/timeline.tsx"],
      "@ui/components/chiffresCles": ["_ui/_components/chiffresCles/chiffresCles.tsx"],
      "@ui/components/imageDialog": ["_ui/_components/imageDialog/imageDialog.tsx"],
      "@ui/client-components/carousel": ["_ui/_client-components/carousel/carousel.tsx"],
      "@ui/client-components/footer": ["_ui/_client-components/footer/footer.tsx"],
      "@ui/client-components/navbarAndSearchMenu": ["_ui/_client-components/navbarAndSearchMenu/navbarAndSearchMenu.tsx"],
      "@ui/client-components/projectListWrapper": ["_ui/_client-components/projectListWrapper/projectListWrapper.tsx"],
      "@ui/client-components/articleListWrapper": ["_ui/_client-components/articleListWrapper/articleListWrapper.tsx"],
      "@ui/client-components/navigateBack": ["_ui/_client-components/navigateBack/navigateBack.tsx"],
      "@services/graphql/*": ["_services/_graphql/*"],
      "@services/remoteHtml": ["_services/_remoteHtml/remoteHtml.tsx"],
      "@services/apollo/*": ["_services/_apollo/*"],
      "@services/cookieConsent/*": ["_services/_cookieConsent/*"],
      "@utils": ["_utils.tsx"],
      "@hooks/*": ["_hooks/*"],
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
